#!/bin/bash -l
# Restart of the three Fresnel jobs (ga0, ga1, ga2) with increased computational-grid
# padding (1x/2x/3x -> 128/256/384). Softplus secret-key fix retained.
#   ga0 -> 1 plane, padding_factor 1.0 (128x128)
#   ga1 -> 2 planes, padding_factor 2.0 (256x256)
#   ga2 -> 3 planes, padding_factor 3.0 (384x384)
# Array index -> config:
#   0 -> ga0.yaml (1 plane fresnel), 1 -> ga1.yaml (2 plane fresnel),
#   2 -> ga2.yaml (3 plane fresnel)
#SBATCH --array=0-2
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH -o ./jobsOut/out_pf.%A_%a
#SBATCH -e ./jobsErr/err_pf.%A_%a
#SBATCH -D ./
#SBATCH -J ga_pf
#SBATCH --mem=16GB
#SBATCH --time=60:00:00
#SBATCH -p bethge

CONFIGS=(configs/ga0.yaml configs/ga1.yaml configs/ga2.yaml)

if module is-avail python 2>/dev/null && module is-avail scipy-stack 2>/dev/null; then
    module load python scipy-stack
else
    echo "Note: 'python'/'scipy-stack' modules not found; using venv python directly."
fi
source venv/bin/activate

srun python run_ga.py --config "${CONFIGS[$SLURM_ARRAY_TASK_ID]}"